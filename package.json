{
  "name": "chrome-dynamic-bookmarks",
  "version": "3.1.4",
  "packageManager": "pnpm@10.33.4",
  "description": "Chrome extension which dynamically updates bookmarks based on the specified regular expression.",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.33.4"
  },
  "scripts": {
    "start": "pnpm dev",
    "watch": "vite build --watch --mode development",
    "dev": "vite build --watch --mode development",
    "dev:analyze": "vite build --watch --mode development --debug",
    "build": "vite build --mode production",
    "build:analyze": "vite build --mode production --debug",
    "test:manual": "node scripts/launch-chrome-extension.js",
    "test:manual:wait": "node scripts/launch-chrome-extension.js --wait-for-build",
    "test:manual:watch": "run-p dev test:manual:wait",
    "clean": "rimraf build",
    "check:types": "run-p check:types:src check:types:test",
    "check:types:src": "tsc -p tsconfig.src.json",
    "check:types:test": "tsc -p tsconfig.test.json",
    "reset": "rimraf node_modules",
    "test": "jest",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:install": "playwright install chromium",
    "lint": "eslint ./src",
    "format": "npm-run-all -s format:js format:stylelint format:prettier",
    "format:js": "eslint --cache --fix ./src",
    "format:stylelint": "stylelint \"**/*.{css}\" --allow-empty-input",
    "format:prettier": "prettier --write \"./src/**/*.{js,jsx,ts,tsx}\" --ignore-unknown",
    "format:prettier:all": "prettier --write \"./src/**/*.{js,jsx,ts,tsx}\" --ignore-unknown",
    "prepare": "husky",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.0.1",
    "@mui/material": "^9.0.1",
    "clsx": "^2.1.1",
    "denque": "^2.1.0",
    "formik": "^2.4.9",
    "lodash": "^4.18.1",
    "notistack": "^3.0.2",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-redux": "^9.2.0",
    "redux": "^5.0.1",
    "redux-logger": "^3.0.6",
    "redux-thunk": "^3.1.0",
    "reselect": "^5.1.1",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-env": "^7.29.5",
    "@babel/preset-react": "^7.28.5",
    "@babel/preset-typescript": "^7.28.5",
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.59.1",
    "@storybook/react-vite": "^10.3.6",
    "@types/chrome": "^0.1.40",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/redux-logger": "^3.0.13",
    "@vitejs/plugin-react": "^6.0.1",
    "babel-jest": "^30.3.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest": "^29.15.2",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "jest": "^30.3.0",
    "lint-staged": "^17.0.2",
    "npm-run-all2": "^8.0.4",
    "prettier": "^3.8.3",
    "prop-types": "^15.8.1",
    "rimraf": "^6.1.3",
    "storybook": "^10.3.6",
    "stylelint": "^17.11.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.10"
  },
  "lint-staged": {
    "src/**/*.{js,jsx,ts,tsx}": [
      "eslint --cache --fix",
      "prettier --write"
    ],
    "**/*.{css,md,json,yml,yaml}": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "unrs-resolver"
    ]
  },
  "main": "index",
  "types": "index",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DaniloNovakovic/chrome-dynamic-bookmarks.git"
  },
  "author": "Danilo Novakovic",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/DaniloNovakovic/chrome-dynamic-bookmarks/issues"
  },
  "homepage": "https://github.com/DaniloNovakovic/chrome-dynamic-bookmarks#readme"
}
